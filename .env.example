# ---- Action API (비밀 값은 .env 에만, 커밋 금지)
ACTION_BASE_URL=https://gyodong-mall-action.aitop100.org
ACTION_TOKEN=aitop100_여기에_토큰
# 대화에 TC ID가 없을 때만 쓰는 기본값(연습용). 평가 때는 비워 두고 대화의 TC ID를 쓴다.
DEFAULT_TC_ID=
ACTION_RATE_PER_MINUTE=95
ACTION_PER_TC_CAP=60

# ---- LLM (OpenAI 호환 서버: scripts/start_llm.sh)
# 에이전트와 모델 서버가 다른 머신이면 Vast.ai 공개 포트/SSH 터널 주소로(예: http://127.0.0.1:8000/v1 via ssh -L)
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=qwen
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.1
LLM_ENABLE_THINKING=0
AGENT_MAX_STEPS=8
AGENT_DEADLINE_SEC=50
# serve.sh 의 동시 요청 한도(--max-num-seqs 4)와 맞춘다
LLM_CONCURRENCY=4
# 대화별 분당 최대 메시지(자동화 대량 요청 방어, 규정 제7·9조)
CONV_MAX_PER_MIN=8

# ---- Kakao
KAKAO_BOT_TOKEN=
KAKAO_API_BASE=https://kapi.kakao.com
BOT_HOST=127.0.0.1
BOT_PORT=9000

# ---- 기타
WORLD_NOW=2037-06-30T10:00:00+09:00
# 에스컬레이션 lane 필드 형식. 공개 TC 모범 처리에서 확인한 형식으로 맞춘다: {lane} | {lane}:{target} | {target}
ESCALATION_LANE_FORMAT={lane}
ESCALATION_TARGET_IN_REASON=1
AGENT_DB_PATH=data/agent.sqlite3
AUDIT_LOG=data/audit.jsonl
# /chat 로컬 검증 엔드포인트 보호용(비우면 /chat 비활성)
ADMIN_TOKEN=
# 인입 계정 머리말 인식 정규식(공개 TC의 실제 표기에 맞춰 조정 가능)
# INBOUND_MARKER_REGEX=(인입\s*계정|로그인\s*(계정|정보|세션)|인증된\s*계정|계정\s*명의|\[시스템\]|\[계정\]|account)
